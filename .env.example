# regtest | signet — see docs/TACHI-API.md
TACHI_NETWORK=regtest

TACHI_URL_REGTEST=https://rpc-regtest.tachibtc.com
TACHI_URL_SIGNET=https://rpc-signet.tachibtc.com

# Local bitcoind (regtest only — the hosted regtest has no bitcoind attached)
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_RPC_USER=tachi
BITCOIN_RPC_PASSWORD=tachi

# Demo wallet — regtest/signet only, never mainnet funds. This is the
# universally-known BIP-39 test vector, not a secret.
DEMO_MNEMONIC="test test test test test test test test test test test junk"

# ai/ package — required for live credit scoring, copilot, and monitor calls.
# Leave unset to run in offline/replay mode (see ai/demo-score.ts, ai/copilot.ts).
ANTHROPIC_API_KEY=
